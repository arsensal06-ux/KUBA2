{
  "firestore": {"rules": "firestore.rules"},
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", ".firebaserc", "firestore.rules", "firestore.indexes.json", "package*.json", "tests/**", "node_modules/**", "README.md", "CHANGELOG.md", "TEST-REPORT.md", "**/.*", "**/*.zip", "assets/sass/**"],
    "headers": [
      {"source": "**", "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"}
      ]},
      {"source": "**/*.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "assets/js/**", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "images/**", "headers": [{"key": "Cache-Control", "value": "public, max-age=86400"}]}
    ]
  }
}
